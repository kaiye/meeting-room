# HTTP listen address
MEETING_ROOM_ADDR=:8090

# SQLite database file. Defaults to <MEETING_ROOM_DATA_DIR>/meetingroom.db, so
# normally you never set this -- the database and the audio stay together in
# one directory that you can back up by copying.
# MEETING_ROOM_DB=./data/meetingroom.db

# Name signed on revisions you write. Defaults to "我".
# MEETING_ROOM_AUTHOR=

# Root directory for the database and uploaded audio
MEETING_ROOM_DATA_DIR=./data

# Shared team token. EMPTY = no auth (the default; fine for local runs).
# Set it only when exposing the server to your team/network, then every API
# request needs `Authorization: Bearer <token>` (WebSocket uses ?token=).
MEETING_ROOM_API_TOKEN=

# ---------------------------------------------------------------------------
# Optional deployment defaults for the transcription service.
# The real configuration lives in the DB and is edited via the settings UI /
# API (PUT /api/v1/settings/transcribe) — supports local (MOSS), LAN, or the
# online OpenAI API (https://api.openai.com/v1) interchangeably. Values here
# only fill fields the UI leaves empty.
# ---------------------------------------------------------------------------
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
TRANSCRIBE_API_KEY=
# Chunk size per request. Keep large (5-10 min) for MOSS-class local services:
# small chunks degrade RTF badly and speaker IDs are only consistent within
# one request. (openai.com handles either; large chunks remain fine.)
TRANSCRIBE_CHUNK_SECONDS=600
